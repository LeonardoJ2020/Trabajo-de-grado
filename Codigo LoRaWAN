/*********************************************************************
  Estación meteorológica + TTN (OTAA) + almacenamiento en microSD

  LilyGO TTGO T3_V1.6.1
  Frecuencia LoRa: 915 MHz
  Región: Colombia - US915

  La estación:
  - Lee los sensores cada 2 segundos.
  - Muestra los datos en el OLED.
  - Muestra los datos por el Monitor Serial.
  - Cada minuto guarda un registro en la microSD.
  - Cada minuto envía los datos a TTN.
*********************************************************************/

#include <Wire.h>
#include <SPI.h>
#include <SD.h>

#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

#include "config.h"
#include "DFRobot_EnvironmentalSensor.h"
#include "DFRobot_AirQualitySensor.h"
#include "SparkFun_Weather_Meter_Kit_Arduino_Library.h"

// RadioLib para LoRaWAN
#include <RadioLib.h>


// ================================================================
// OLED
// ================================================================

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_ADDR 0x3C

Adafruit_SSD1306 display(
  SCREEN_WIDTH,
  SCREEN_HEIGHT,
  &Wire,
  -1
);


// ================================================================
// SENSORES DFRobot
// ================================================================

DFRobot_EnvironmentalSensor environment(
  SEN050X_DEFAULT_DEVICE_ADDRESS,
  &Wire
);

#define SEN0460_ADDR 0x19

DFRobot_AirQualitySensor particle(
  &Wire,
  SEN0460_ADDR
);


// ================================================================
// SENSOR METEOROLÓGICO
// ================================================================
//
// La microSD de esta placa utiliza GPIO14 y GPIO15.
// Por eso no podemos usar esos dos pines para el anemómetro
// y el pluviómetro.
//
// Veleta       -> GPIO35
// Anemómetro   -> GPIO33
// Pluviómetro  -> GPIO32
//

int windDirectionPin = 35;
int windSpeedPin     = 33;
int rainfallPin      = 32;

SFEWeatherMeterKit weatherMeterKit(
  windDirectionPin,
  windSpeedPin,
  rainfallPin
);


// ================================================================
// MICROSD / TF
// ================================================================
//
// Pinout de la microSD de la TTGO T3_V1.6.1:
//
// CS   -> GPIO13
// MOSI -> GPIO15
// SCK  -> GPIO14
// MISO -> GPIO2
//

#define SD_CS    13
#define SD_MOSI  15
#define SD_SCK   14
#define SD_MISO  2

const char* archivoCSV = "/datos_estacion.csv";


// ================================================================
// TIEMPOS
// ================================================================

// Los datos se envían y guardan cada minuto.
unsigned long ultimoEnvioTTN = 0;

const unsigned long intervaloTTN =
  1UL * 60UL * 1000UL;


// Actualización de pantalla y Serial cada 2 segundos.
unsigned long ultimaLectura = 0;

const unsigned long intervaloLectura =
  2000UL;


// Guarda la cantidad de lluvia que había
// al comenzar el último intervalo.
float lluviaInicioIntervalo = 0.0;


// Nos indica si el sensor SEN0460 funcionó correctamente.
bool airSensorOK = false;


// ================================================================
// CREAR EL ARCHIVO CSV
// ================================================================

void prepararArchivoCSV() {

  // Si el archivo todavía no existe, lo creamos
  // y ponemos los nombres de las columnas.

  if (!SD.exists(archivoCSV)) {

    File archivo = SD.open(
      archivoCSV,
      FILE_WRITE
    );

    if (!archivo) {

      Serial.println(
        "No se pudo crear el archivo CSV."
      );

      return;
    }

    archivo.println(
      "tiempo_s,"
      "temperatura_C,"
      "humedad_pct,"
      "presion_hPa,"
      "uv,"
      "luminosidad_lux,"
      "PM1_ug_m3,"
      "PM2_5_ug_m3,"
      "PM10_ug_m3,"
      "velocidad_viento_kmh,"
      "direccion_viento_grados,"
      "lluvia_intervalo_mm,"
      "lluvia_acumulada_mm"
    );

    archivo.close();

    Serial.println(
      "Archivo datos_estacion.csv creado."
    );

  } else {

    Serial.println(
      "Archivo datos_estacion.csv encontrado."
    );
  }
}


// ================================================================
// GUARDAR LOS DATOS EN LA MICROSD
// ================================================================

void guardarEnMicroSD(
  float tempC,
  float hum,
  float press,
  float uv,
  float lux,
  uint16_t PM1_0,
  uint16_t PM2_5,
  uint16_t PM10,
  float windSpd,
  float windDir,
  float lluviaIntervalo,
  float rainTotal
) {

  File archivo = SD.open(
    archivoCSV,
    FILE_APPEND
  );

  if (!archivo) {

    Serial.println(
      "No se pudo abrir la microSD para guardar los datos."
    );

    return;
  }


  // Tiempo transcurrido desde que se encendió la ESP32.
  archivo.print(millis() / 1000);
  archivo.print(",");


  // Temperatura
  archivo.print(tempC, 2);
  archivo.print(",");


  // Humedad
  archivo.print(hum, 2);
  archivo.print(",");


  // Presión
  archivo.print(press, 2);
  archivo.print(",");


  // Radiación UV
  archivo.print(uv, 2);
  archivo.print(",");


  // Luminosidad
  archivo.print(lux, 2);
  archivo.print(",");


  // PM1.0
  archivo.print(PM1_0);
  archivo.print(",");


  // PM2.5
  archivo.print(PM2_5);
  archivo.print(",");


  // PM10
  archivo.print(PM10);
  archivo.print(",");


  // Velocidad del viento
  archivo.print(windSpd, 2);
  archivo.print(",");


  // Dirección del viento
  archivo.print(windDir, 2);
  archivo.print(",");


  // Lluvia registrada durante este minuto
  archivo.print(lluviaIntervalo, 2);
  archivo.print(",");


  // Lluvia acumulada
  archivo.println(rainTotal, 2);


  archivo.close();


  Serial.println(
    "Datos guardados correctamente en la microSD."
  );
}


// ================================================================
// SETUP
// ================================================================

void setup() {

  Serial.begin(115200);

  // El OLED y los sensores I2C trabajan por estos dos pines.
  Wire.begin(21, 22);


  // ==============================================================
  // OLED
  // ==============================================================

  if (!display.begin(
        SSD1306_SWITCHCAPVCC,
        OLED_ADDR
      )) {

    Serial.println(
      "Error al iniciar el OLED."
    );

    while (true) {
      delay(1000);
    }
  }


  display.clearDisplay();

  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);

  display.setCursor(0, 0);

  display.println(
    "Iniciando..."
  );

  display.display();


  // ==============================================================
  // MICROSD
  // ==============================================================

  Serial.println();
  Serial.println(
    "Inicializando microSD..."
  );

  Serial.println(
    "CS=13 | MOSI=15 | SCK=14 | MISO=2"
  );


  // Configuramos los pines SPI de la tarjeta
  // porque esta placa no utiliza el mismo pinout
  // SPI que algunas otras ESP32.

  SPI.begin(
    SD_SCK,
    SD_MISO,
    SD_MOSI,
    SD_CS
  );


  if (!SD.begin(
        SD_CS,
        SPI
      )) {

    Serial.println(
      "ERROR: no se pudo iniciar la microSD."
    );

    display.clearDisplay();

    display.setCursor(0, 0);

    display.println(
      "Error microSD"
    );

    display.println(
      "Revisar tarjeta"
    );

    display.display();


    while (true) {
      delay(1000);
    }
  }


  Serial.println(
    "microSD iniciada correctamente."
  );


  prepararArchivoCSV();


  // ==============================================================
  // SENSOR SEN0501
  // ==============================================================

  while (
    environment.begin() != 0
  ) {

    Serial.println(
      "SEN0501 no detectado."
    );

    delay(1000);
  }

  Serial.println(
    "SEN0501 listo."
  );


  // ==============================================================
  // SENSOR SEN0460
  // ==============================================================

  int intentos = 0;

  while (
    !particle.begin() &&
    intentos < 5
  ) {

    Serial.println(
      "SEN0460 no detectado..."
    );

    delay(1000);

    intentos++;
  }


  if (particle.begin()) {

    airSensorOK = true;

    Serial.println(
      "SEN0460 listo."
    );

  } else {

    Serial.println(
      "SEN0460 no disponible."
    );

    Serial.println(
      "Los valores de PM quedaran en 0."
    );
  }


  // ==============================================================
  // WEATHER METER
  // ==============================================================

#ifdef SFE_WMK_PLAFTORM_UNKNOWN

  weatherMeterKit.setADCResolutionBits(12);

#endif

  weatherMeterKit.begin();

  Serial.println(
    "Weather Meter Kit listo."
  );


  // ==============================================================
  // LORAWAN
  // ==============================================================

  Serial.println();
  Serial.println(
    "Iniciando modulo LoRaWAN..."
  );


  int16_t state =
    radio.begin();


  if (
    state !=
    RADIOLIB_ERR_NONE
  ) {

    Serial.printf(
      "Error al iniciar radio: %d\n",
      state
    );

    while (true) {
      delay(1000);
    }
  }


  state =
    node.beginOTAA(
      joinEUI,
      devEUI,
      nwkKey,
      appKey
    );


  if (
    state !=
    RADIOLIB_ERR_NONE
  ) {

    Serial.printf(
      "Error beginOTAA: %d\n",
      state
    );

    while (true) {
      delay(1000);
    }
  }


  Serial.println(
    "Intentando JOIN OTAA..."
  );


  while (true) {

    state =
      node.activateOTAA();


    if (
      state ==
      RADIOLIB_LORAWAN_NEW_SESSION
    ) {

      Serial.println(
        "JOIN exitoso."
      );

      break;
    }


    Serial.printf(
      "JOIN fallo (%d). "
      "Reintentando en 15 segundos...\n",
      state
    );

    delay(15000);
  }


  // Guardamos la lluvia acumulada que tenemos
  // justo después de iniciar la estación.
  lluviaInicioIntervalo =
    weatherMeterKit.getTotalRainfall();


  display.clearDisplay();

  display.setCursor(0, 0);

  display.println(
    "Weather Station"
  );

  display.println(
    "TTN + microSD OK"
  );

  display.display();

  delay(2000);
}


// ================================================================
// LOOP
// ================================================================

void loop() {

  // Cada dos segundos actualizamos la información
  // que vemos en pantalla y en el Monitor Serial.

  if (
    millis() - ultimaLectura
    >= intervaloLectura
  ) {

    ultimaLectura =
      millis();


    // ============================================================
    // LEER SEN0501
    // ============================================================

    float tempC =
      environment.getTemperature(
        TEMP_C
      );


    float hum =
      environment.getHumidity();


    float uv =
      environment.getUltravioletIntensity();


    if (uv < 0) {
      uv = 0;
    }


    float lux =
      environment.getLuminousIntensity();


    float press =
      environment.getAtmospherePressure(
        HPA
      );


    // ============================================================
    // LEER SEN0460
    // ============================================================

    uint16_t PM1_0 = 0;
    uint16_t PM2_5 = 0;
    uint16_t PM10  = 0;


    if (airSensorOK) {

      PM1_0 =
        particle.gainParticleConcentration_ugm3(
          PARTICLE_PM1_0_ATMOSPHERE
        );


      PM2_5 =
        particle.gainParticleConcentration_ugm3(
          PARTICLE_PM2_5_ATMOSPHERE
        );


      PM10 =
        particle.gainParticleConcentration_ugm3(
          PARTICLE_PM10_ATMOSPHERE
        );
    }


    // ============================================================
    // LEER WEATHER METER
    // ============================================================

    float windDir =
      weatherMeterKit.getWindDirection();


    float windSpd =
      weatherMeterKit.getWindSpeed();


    float rainTotal =
      weatherMeterKit.getTotalRainfall();


    // ============================================================
    // MOSTRAR LOS DATOS EN SERIAL
    // ============================================================

    Serial.println();

    Serial.println(
      "========== ESTACION =========="
    );


    Serial.printf(
      "Temp: %.2f C | Hum: %.2f %%\n",
      tempC,
      hum
    );


    Serial.printf(
      "UV: %.2f | Luz: %.0f lx | Pres: %.1f hPa\n",
      uv,
      lux,
      press
    );


    Serial.printf(
      "PM1.0: %u | PM2.5: %u | PM10: %u ug/m3\n",
      PM1_0,
      PM2_5,
      PM10
    );


    Serial.printf(
      "Viento: %.2f km/h | Dir: %.1f grados\n",
      windSpd,
      windDir
    );


    Serial.printf(
      "Lluvia acumulada: %.2f mm\n",
      rainTotal
    );


    // ============================================================
    // ACTUALIZAR OLED
    // ============================================================

    display.clearDisplay();

    display.setCursor(0, 0);

    display.println(
      " Weather Station"
    );


    display.print("T: ");
    display.print(tempC, 1);
    display.println(" C");


    display.print("H: ");
    display.print(hum, 0);
    display.println(" %");


    display.print("P: ");
    display.print(press, 0);
    display.println(" hPa");


    display.print("V: ");
    display.print(windSpd, 1);
    display.println(" km/h");


    display.print("D: ");
    display.print(windDir, 0);
    display.println(" deg");


    display.display();


    // ============================================================
    // CADA MINUTO
    // GUARDAR EN SD + ENVIAR A TTN
    // ============================================================

    if (
      millis() - ultimoEnvioTTN
      >= intervaloTTN
    ) {


      // Calculamos cuánto llovió desde el último
      // registro guardado.

      float lluviaIntervalo =
        rainTotal -
        lluviaInicioIntervalo;


      // ==========================================================
      // GUARDAR EN MICROSD
      // ==========================================================

      guardarEnMicroSD(
        tempC,
        hum,
        press,
        uv,
        lux,
        PM1_0,
        PM2_5,
        PM10,
        windSpd,
        windDir,
        lluviaIntervalo,
        rainTotal
      );


      // ==========================================================
      // PREPARAR DATOS PARA TTN
      // ==========================================================

      uint8_t payload[20] = {0};


      // Temperatura x10
      int16_t temp10 =
        (int16_t)round(
          tempC * 10
        );


      payload[0] =
        highByte(temp10);

      payload[1] =
        lowByte(temp10);


      // Humedad x2
      payload[2] =
        (uint8_t)round(
          hum * 2
        );


      // Presión x10
      uint16_t pres10 =
        (uint16_t)round(
          press * 10
        );


      payload[3] =
        highByte(pres10);

      payload[4] =
        lowByte(pres10);


      // Velocidad del viento x10
      uint16_t wind10 =
        (uint16_t)round(
          windSpd * 10
        );


      payload[5] =
        highByte(wind10);

      payload[6] =
        lowByte(wind10);


      // Dirección del viento
      uint16_t dir =
        (uint16_t)round(
          windDir
        );


      payload[7] =
        highByte(dir);

      payload[8] =
        lowByte(dir);


      // Lluvia del último minuto x100
      uint16_t rain100 =
        (uint16_t)round(
          lluviaIntervalo * 100
        );


      payload[9] =
        highByte(rain100);

      payload[10] =
        lowByte(rain100);


      // UV x100
      uint16_t uv100 =
        (uint16_t)round(
          uv * 100
        );


      payload[11] =
        highByte(uv100);

      payload[12] =
        lowByte(uv100);


      // Luminosidad
      uint16_t luz =
        (uint16_t)round(
          lux
        );


      payload[13] =
        highByte(luz);

      payload[14] =
        lowByte(luz);


      // PM1.0
      payload[15] =
        (uint8_t)constrain(
          PM1_0,
          0,
          255
        );


      // PM2.5
      payload[16] =
        (uint8_t)constrain(
          PM2_5,
          0,
          255
        );


      // PM10
      payload[17] =
        (uint8_t)constrain(
          PM10,
          0,
          255
        );


      // ==========================================================
      // ENVIAR A TTN
      // ==========================================================

      Serial.println();

      Serial.println(
        "Enviando datos a TTN..."
      );


      int16_t state =
        node.sendReceive(
          payload,
          sizeof(payload)
        );


      if (
        state <
        RADIOLIB_ERR_NONE
      ) {

        Serial.printf(
          "Error en envio TTN: %d\n",
          state
        );

      } else {

        Serial.println(
          "Uplink enviado correctamente."
        );


        if (state > 0) {

          Serial.println(
            "Downlink recibido."
          );
        }
      }


      // Empezamos a contar nuevamente la lluvia
      // para el próximo intervalo.

      lluviaInicioIntervalo =
        rainTotal;


      ultimoEnvioTTN =
        millis();
    }
  }


  // Un pequeño descanso para no mantener
  // el procesador ocupado innecesariamente.

  delay(50);
}
