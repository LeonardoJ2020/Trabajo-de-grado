// Payload formatter de uplink (TTN) - versión de enero 2026, corregida.
// Formato: dos paquetes por ciclo, ambos en el puerto 1.
//   Paquete "main"      : 15 bytes (variables ambientales)
//   Paquete "particles" :  5 bytes (material particulado)
// Los nombres de campo se mantienen iguales a los de la versión original
// para no afectar la integración con AWS.

// true  = agrega los bytes 3 y 4 del paquete de partículas como valores crudos
// false = salida idéntica a la versión original
var INCLUDE_RAW_RESERVED = true;

function u16(b, i) {
  return (b[i] << 8) | b[i + 1];
}

function decodeUplink(input) {
  var bytes = input.bytes;
  var decoded = {};
  var warnings = [];

  // ---------------- Paquete 1: ambiental (15 bytes) ----------------
  if (bytes.length === 15) {
    // Temperatura: bytes 0-1, entero con signo, escala x10 (°C)
    var tempRaw = u16(bytes, 0);
    if (tempRaw & 0x8000) tempRaw -= 0x10000;
    decoded.temp = tempRaw / 10.0;

    decoded.hum = bytes[2] / 2.0;          // byte 2, x2 (% HR)
    decoded.press = u16(bytes, 3) / 10.0;  // bytes 3-4, x10 (hPa)
    decoded.windSpd = u16(bytes, 5) / 10.0;// bytes 5-6, x10 (km/h)
    decoded.windDir = u16(bytes, 7);       // bytes 7-8 (grados)
    decoded.rain = u16(bytes, 9) / 100.0;  // bytes 9-10, x100 (mm del intervalo)
    decoded.uv = u16(bytes, 11) / 100.0;   // bytes 11-12, x100 (índice UV)
    decoded.lux = u16(bytes, 13);          // bytes 13-14 (lux, máx. 65535)
    decoded.payload_type = "main";

    if (decoded.lux === 65535) {
      warnings.push("Iluminancia en el maximo representable (65535 lux): posible saturacion");
    }
    return { data: decoded, warnings: warnings, errors: [] };
  }

  // ---------------- Paquete 2: particulas (5 bytes) ----------------
  if (bytes.length === 5) {
    decoded.pm1_0 = bytes[0];   // ug/m3, uint8 (0-255)
    decoded.pm2_5 = bytes[1];
    decoded.pm10 = bytes[2];
    decoded.payload_type = "particles";

    if (INCLUDE_RAW_RESERVED) {
      // Bytes 3 y 4: contenido no documentado, se exponen sin interpretar
      decoded.reserved_b3 = bytes[3];
      decoded.reserved_b4 = bytes[4];
    }
    if (bytes[0] === 255 || bytes[1] === 255 || bytes[2] === 255) {
      warnings.push("Valor de particulas en 255 ug/m3 (maximo de 1 byte): posible saturacion");
    }
    return { data: decoded, warnings: warnings, errors: [] };
  }

  // ---------------- Longitud no reconocida ----------------
  return {
    data: { payload_type: "unknown", length: bytes.length },
    warnings: ["Tamano de payload no reconocido: " + bytes.length + " bytes"],
    errors: []
  };
}
