// -------------------- Sensor meteorológico DS-15901 --------------------
int windDirectionPin = 35;   // ADC - Veleta
int windSpeedPin     = 14;   // Digital - Anemómetro (medición directa)
int rainfallPin      = 15;   // Digital - Pluviómetro (medición directa)
SFEWeatherMeterKit weatherMeterKit(windDirectionPin, windSpeedPin, rainfallPin);

// -------------------- microSD --------------------
#define SD_CS 13   // ⚠️ AJUSTA este pin según tu cableado real de la SD
bool sdDisponible = false;
const char* ARCHIVO_PENDIENTES = "/pending.csv";
const char* ARCHIVO_TEMP       = "/pending.tmp";

// -------------------- Variables globales para envío TTN --------------------
unsigned long ultimoEnvioTTN = 0;
const unsigned long intervaloTTN = 5UL * 60UL * 1000UL;  // CADA 5 MINUTOS

float lluviaInicioIntervalo = 0.0;


// -------------------- Límites de reintento (anti-bloqueo) --------------------
const uint8_t MAX_INTENTOS_SENSOR_AMBIENTAL = 10;   // ~10 s antes de reiniciar
const uint8_t MAX_INTENTOS_RADIO            = 3;    // reintentos radio.begin()/beginOTAA()
const uint8_t MAX_INTENTOS_JOIN             = 10;   // ~2.5 min (10 x 15 s) antes de reiniciar

// ==================== FUNCIÓN DIRECCIÓN EN ESPAÑOL ====================
const char* direccionEspanol(float grados) {
  while (grados < 0) grados += 360;
  while (grados >= 360) grados -= 360;

  if (grados >= 337.5 || grados < 22.5)  return "Norte";
  if (grados >= 22.5 && grados < 67.5)   return "Noreste";
  if (grados >= 67.5 && grados < 112.5)  return "Este";
  if (grados >= 112.5 && grados < 157.5) return "Sureste";
  if (grados >= 157.5 && grados < 202.5) return "Sur";
  if (grados >= 202.5 && grados < 247.5) return "Suroeste";
  if (grados >= 247.5 && grados < 292.5) return "Oeste";
  return "Noroeste";
}

// ==================== HELPERS ANTI-BLOQUEO ====================
void reiniciarConMensaje(const char* motivo) {
  Serial.print(F("❌ Reiniciando ESP32. Motivo: "));
  Serial.println(motivo);
  display.clearDisplay();
  display.setCursor(0, 0);
  display.println("Reiniciando...");
  display.println(motivo);
  display.display();
  delay(2000);
  ESP.restart();
}

// ==================== HELPERS microSD (cola de pendientes) ====================

// Convierte un payload binario a texto hexadecimal y lo agrega como
// una nueva línea en /pending.csv, precedido por millis() (referencia
// de tiempo relativa, útil para depurar el orden de la cola).
void encolarPendiente(uint8_t* payload, size_t len) {
  if (!sdDisponible) return;
  File f = SD.open(ARCHIVO_PENDIENTES, FILE_APPEND);
  if (!f) {
    Serial.println(F("⚠️ No se pudo abrir pending.csv para escribir"));
    return;
  }
  f.print(millis());
  f.print(',');
  for (size_t i = 0; i < len; i++) {
    if (payload[i] < 16) f.print('0');
    f.print(payload[i], HEX);
  }
  f.println();
  f.close();
}

// ¿Hay al menos un registro pendiente en la SD?
bool hayPendientes() {
  if (!sdDisponible) return false;
  if (!SD.exists(ARCHIVO_PENDIENTES)) return false;
  File f = SD.open(ARCHIVO_PENDIENTES, FILE_READ);
  if (!f) return false;
  bool tieneContenido = f.available() > 0;
  f.close();
  return tieneContenido;
}

// Lee la primera línea de /pending.csv, decodifica el payload hexadecimal
// hacia "payload" (de tamaño len) y devuelve true si lo logró.
bool obtenerPrimerPendiente(uint8_t* payload, size_t len) {
  if (!sdDisponible) return false;
  File f = SD.open(ARCHIVO_PENDIENTES, FILE_READ);
  if (!f) return false;

  String linea = f.readStringUntil('\n');
  f.close();
  linea.trim();
  if (linea.length() == 0) return false;

  int comaPos = linea.indexOf(',');
  if (comaPos < 0) return false;

  String hexStr = linea.substring(comaPos + 1);
  if (hexStr.length() < len * 2) return false;

  for (size_t i = 0; i < len; i++) {
    String byteStr = hexStr.substring(i * 2, i * 2 + 2);
    payload[i] = (uint8_t) strtoul(byteStr.c_str(), nullptr, 16);
  }
  return true;
}

// Elimina la primera línea de /pending.csv (ya fue enviada con éxito),
// reescribiendo el resto del archivo mediante un archivo temporal.
void eliminarPrimerPendiente() {
  if (!sdDisponible) return;
  File origen = SD.open(ARCHIVO_PENDIENTES, FILE_READ);
  if (!origen) return;

  SD.remove(ARCHIVO_TEMP);
  File destino = SD.open(ARCHIVO_TEMP, FILE_WRITE);
  if (!destino) {
    origen.close();
    return;
  }

  bool primeraLineaSaltada = false;
  while (origen.available()) {
    String linea = origen.readStringUntil('\n');
    if (!primeraLineaSaltada) {
      primeraLineaSaltada = true;
      continue; // se descarta la primera línea (ya enviada)
    }
    if (linea.length() > 0) {
      destino.println(linea);
    }
  }
  origen.close();
  destino.close();

  SD.remove(ARCHIVO_PENDIENTES);
  // Renombrar temp -> pending.csv copiando su contenido
  File temp = SD.open(ARCHIVO_TEMP, FILE_READ);
  File nuevo = SD.open(ARCHIVO_PENDIENTES, FILE_WRITE);
  if (temp && nuevo) {
    while (temp.available()) {
      nuevo.write(temp.read());
    }
  }
  if (temp) temp.close();
  if (nuevo) nuevo.close();
  SD.remove(ARCHIVO_TEMP);
}

// Cuenta cuántos registros hay en la cola (solo para mostrar en pantalla;
// si la cola crece mucho esto se vuelve costoso, pero es aceptable para
// backlogs de horas/días de una estación de 5 min por lectura).
uint16_t contarPendientes() {
  if (!hayPendientes()) return 0;
  File f = SD.open(ARCHIVO_PENDIENTES, FILE_READ);
  if (!f) return 0;
  uint16_t contador = 0;
  while (f.available()) {
    String linea = f.readStringUntil('\n');
    if (linea.length() > 0) contador++;
  }
  f.close();
  return contador;
}

void setup() {
  Serial.begin(115200);
  Wire.begin(21, 22);

  if (!display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDR)) {
    Serial.println(F("❌ Error OLED, reintentando..."));
    uint8_t intentosOled = 0;
    while (!display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDR)) {
      delay(1000);
      intentosOled++;
      if (intentosOled >= 5) {
        Serial.println(F("❌ OLED no responde, reiniciando..."));
        delay(2000);
        ESP.restart();
      }
    }
  }
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(0, 0);
  display.println("Iniciando...");
  display.display();

  // ---- microSD: no es crítica, si falla se continúa sin respaldo ----
  if (SD.begin(SD_CS)) {
    sdDisponible = true;
    Serial.println("✅ microSD OK");
    if (!SD.exists(ARCHIVO_PENDIENTES)) {
      File f = SD.open(ARCHIVO_PENDIENTES, FILE_WRITE);
      if (f) f.close();
    }
  } else {
    sdDisponible = false;
    Serial.println("⚠️ microSD no detectada, se continúa SIN respaldo local");
  }

  // ---- SEN0501: reintento acotado en vez de while(...) infinito ----
  uint8_t intentosEnv = 0;
  while (environment.begin() != 0) {
    Serial.println(F("⚠️ Reintentando SEN0501..."));
    delay(1000);
    intentosEnv++;
    if (intentosEnv >= MAX_INTENTOS_SENSOR_AMBIENTAL) {
      reiniciarConMensaje("SEN0501 no responde");
    }
  }
  Serial.println("✅ SEN0501 OK");

  int intentos = 0;
  while (!particle.begin() && intentos < 5) {
    delay(1000);
    intentos++;
  }
  if (particle.begin()) Serial.println("✅ SEN0460 OK");
  else Serial.println("⚠️ SEN0460 no disponible, se continúa sin PM.");

#ifdef SFE_WMK_PLAFTORM_UNKNOWN
  weatherMeterKit.setADCResolutionBits(12);
#endif
  weatherMeterKit.begin();
  Serial.println("✅ Weather Meter OK");

  // ---- LoRaWAN JOIN: sin while(true) sin salida ----
  int16_t state = radio.begin();
  uint8_t intentosRadio = 0;
  while (state != RADIOLIB_ERR_NONE) {
    Serial.printf("⚠️ radio.begin() falló (código %d), reintentando...\n", state);
    delay(1000);
    intentosRadio++;
    if (intentosRadio >= MAX_INTENTOS_RADIO) {
      reiniciarConMensaje("Fallo radio.begin()");
    }
    state = radio.begin();
  }

  state = node.beginOTAA(joinEUI, devEUI, nwkKey, appKey);
  intentosRadio = 0;
  while (state != RADIOLIB_ERR_NONE) {
    Serial.printf("⚠️ beginOTAA() falló (código %d), reintentando...\n", state);
    delay(1000);
    intentosRadio++;
    if (intentosRadio >= MAX_INTENTOS_RADIO) {
      reiniciarConMensaje("Fallo beginOTAA()");
    }
    state = node.beginOTAA(joinEUI, devEUI, nwkKey, appKey);
  }

  // ---- JOIN OTAA: reintentos acotados (antes era while(true) eterno) ----
  uint8_t intentosJoin = 0;
  while (true) {
    state = node.activateOTAA();
    if (state == RADIOLIB_LORAWAN_NEW_SESSION) {
      Serial.println(F("✅ ¡JOIN exitoso!"));
      break;
    }
    intentosJoin++;
    Serial.printf("⚠️ Intento JOIN %d/%d fallido (código %d)\n",
                  intentosJoin, MAX_INTENTOS_JOIN, state);
    if (intentosJoin >= MAX_INTENTOS_JOIN) {
      // No perdemos nada: si hay datos futuros y el join sigue fallando
      // tras reiniciar, seguirán respaldándose en la SD igualmente.
      reiniciarConMensaje("No se pudo unir a TTN");
    }
    delay(15000);
  }

  lluviaInicioIntervalo = weatherMeterKit.getTotalRainfall();

  display.clearDisplay();
  display.setCursor(0, 0);
  display.println("Todo OK + TTN 5min");
  if (sdDisponible) display.println("SD: lista");
  else display.println("SD: no disponible");
  display.display();
  delay(2000);
}

void loop() {
  float tempC = environment.getTemperature(TEMP_C);
  float hum   = environment.getHumidity();
  float uv    = max(environment.getUltravioletIntensity(), 0.0f);
  float lux   = environment.getLuminousIntensity();
  float press = environment.getAtmospherePressure(HPA);

  uint16_t PM1_0 = 0, PM2_5 = 0, PM10 = 0;
  if (particle.begin()) {
    PM1_0 = particle.gainParticleConcentration_ugm3(PARTICLE_PM1_0_ATMOSPHERE);
    PM2_5 = particle.gainParticleConcentration_ugm3(PARTICLE_PM2_5_ATMOSPHERE);
    PM10  = particle.gainParticleConcentration_ugm3(PARTICLE_PM10_ATMOSPHERE);
  }

  float windDirGrados = weatherMeterKit.getWindDirection();
  const char* windDirEspanol = direccionEspanol(windDirGrados);
  float windSpdMedida = weatherMeterKit.getWindSpeed();
  float rainTotal = weatherMeterKit.getTotalRainfall();

  // Usar únicamente las mediciones reales de los sensores.
  // No se realizan estimaciones ni sustituciones de valores.
  float windSpd = windSpdMedida;

  // Lluvia medida por el pluviómetro DS-15901 durante el intervalo.
  float lluviaNueva = rainTotal - lluviaInicioIntervalo;
  if (lluviaNueva < 0.0) lluviaNueva = 0.0;

  // =================== Mostrar en Serial ===================
  Serial.println("===== SEN0501 =====");
  Serial.printf("Temp: %.2f°C | Hum: %.2f%% | UV: %.2f | Luz: %.0f lx | Pres: %.1f hPa\n", tempC, hum, uv, lux, press);
  if (particle.begin()) {
    Serial.println("===== SEN0460 =====");
    Serial.printf("PM1.0: %u | PM2.5: %u | PM10: %u µg/m³\n", PM1_0, PM2_5, PM10);
  }
  Serial.println("===== DS-15901 =====");
  Serial.printf("Dir: %s (%.0f°) | Vel: %.2f km/h (medida) | Lluvia intervalo: %.2f mm (medida)\n",
                windDirEspanol, windDirGrados, windSpd, lluviaNueva);

  // =================== Mostrar en OLED ===================
  display.clearDisplay();
  display.setCursor(0, 0);
  display.println(" Weather Station");
  display.print("T: "); display.print(tempC, 1); display.println(" C");
  display.print("H: "); display.print(hum, 0); display.println(" %");
  display.print("P: "); display.print(press, 0); display.println(" hPa");
  display.print("V: "); display.print(windSpd, 1); display.println(" km/h");
  display.print("D: "); display.println(windDirEspanol);
  display.print("Lluvia: "); display.print(lluviaNueva, 2); display.println(" mm");
  display.display();

  // =================== Envío a TTN cada 5 minutos ===================
  if (millis() - ultimoEnvioTTN >= intervaloTTN) {
    uint8_t payload[20] = {0};

    int16_t temp10 = round(tempC * 10); payload[0] = highByte(temp10); payload[1] = lowByte(temp10);
    payload[2] = round(hum * 2);
    uint16_t pres10 = round(press * 10); payload[3] = highByte(pres10); payload[4] = lowByte(pres10);
    uint16_t wind10 = round(windSpd * 10); payload[5] = highByte(wind10); payload[6] = lowByte(wind10);
    uint16_t dir = round(windDirGrados); payload[7] = highByte(dir); payload[8] = lowByte(dir);
    uint16_t rain100 = round(lluviaNueva * 100); payload[9] = highByte(rain100); payload[10] = lowByte(rain100);
    uint16_t uv100 = round(uv * 100); payload[11] = highByte(uv100); payload[12] = lowByte(uv100);
    uint16_t luz = round(lux); payload[13] = highByte(luz); payload[14] = lowByte(luz);
    payload[15] = constrain(PM1_0, 0, 255);
    payload[16] = constrain(PM2_5, 0, 255);
    payload[17] = constrain(PM10, 0, 255);

    // ---- NUEVO: si hay backlog en SD, se prioriza reenviar el más antiguo ----
    bool esDeCola = false;
    uint8_t payloadAEnviar[20];

    if (sdDisponible && hayPendientes() && obtenerPrimerPendiente(payloadAEnviar, sizeof(payloadAEnviar))) {
      esDeCola = true;
      Serial.printf("📤 Reintentando envío pendiente de la SD (%u en cola)...\n", contarPendientes());
    } else {
      memcpy(payloadAEnviar, payload, sizeof(payload));
    }

    Serial.println(F("\n📡 Enviando a TTN (cada 5 min)..."));
    int16_t state = node.sendReceive(payloadAEnviar, sizeof(payloadAEnviar));

    if (state < RADIOLIB_ERR_NONE) {
      Serial.printf("❌ Error envío: %d\n", state);
      if (sdDisponible && !esDeCola) {
        // Solo se encola si era la lectura NUEVA (la pendiente ya estaba en cola)
        encolarPendiente(payload, sizeof(payload));
        Serial.println(F("💾 Lectura guardada en microSD para reintento posterior"));
      }
    } else {
      Serial.println("✅ Uplink enviado correctamente");
      if (esDeCola) {
        // Se envió un pendiente: lo quitamos de la cola y encolamos la
        // lectura actual para respetar el orden y no perderla.
        eliminarPrimerPendiente();
        if (sdDisponible) encolarPendiente(payload, sizeof(payload));
      }
    }

    lluviaInicioIntervalo = rainTotal;
    ultimoEnvioTTN = millis();
  }

  delay(2000);
}
